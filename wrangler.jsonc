{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noon-sight",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  // Access is enabled per hostname, so every hostname this Worker answers on is
  // one that has to be guarded. The custom domain is that hostname; the
  // workers.dev URL and the per-version preview URLs would accumulate entrances
  // nobody remembers to guard, so neither is minted.
  "routes": [{ "pattern": "noon-sight.aotoki.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // A Google access token lives an hour and is the same for every request, so
  // it is cached rather than minted per call. KV expires it by TTL, which is
  // why nothing here ever deletes a key.
  //
  // Declared without an id so wrangler provisions the namespace itself and
  // names it after this Worker. A hand-made namespace carries a name that says
  // nothing about what it belongs to, and an account-specific id in the
  // repository is one more thing that has to be true of whoever deploys.
  "kv_namespaces": [
    {
      "binding": "TOKEN_CACHE",
    },
  ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
