{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/edit.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop.sh",
            "args": [],
            "timeout": 180,
            "statusMessage": "Typechecking and testing"
          }
        ]
      }
    ]
  }
}
